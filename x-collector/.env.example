# Point this at a dedicated PostgreSQL database named x_collector.
DATABASE_URL=postgresql://collector:change_me@127.0.0.1:5434/x_collector

# Keep a permanent random 32-byte key outside Git. Losing it makes stored sessions unreadable.
MASTER_KEY=

# Optional override for the config file path (defaults to config/default.json).
CONFIG_FILE=config/default.json

WORKER_ID=
METRICS_HOST=127.0.0.1
METRICS_PORT=9091
METRICS_USER=
METRICS_PASS=
# Requests per minute per IP for the worker metrics/health server (0 disables the limit).
METRICS_RATE_LIMIT=600

# Dashboard: keep loopback unless behind a secured TLS reverse proxy.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3001
DASHBOARD_USER=
DASHBOARD_PASS=
# Required together with credentials when DASHBOARD_HOST is non-loopback.
# Must match the browser Origin/Referer of mutating requests, without a trailing slash.
DASHBOARD_ORIGIN=
# Requests per minute per IP (0 disables the limit).
DASHBOARD_RATE_LIMIT=120

# Optional notification channels. Leave disabled until delivery is verified.
# TG_BOT_TOKEN= / TG_CHAT_ID= enable Telegram; WEBHOOK_URL enables the webhook channel.
TG_BOT_TOKEN=
TG_CHAT_ID=
WEBHOOK_URL=

LOG_LEVEL=info
LOG_DIR=logs
