# Point this at a dedicated PostgreSQL database named x_collector.
DATABASE_URL=postgresql://collector:change_me@127.0.0.1:5434/x_collector

# Keep a permanent random 32-byte key outside Git. Losing it makes stored sessions unreadable.
MASTER_KEY=

# Optional override for the config file path (defaults to config/default.json).
CONFIG_FILE=config/default.json

WORKER_ID=
# Each process appends a UUID; this value is an instance name prefix.
WORKER_SHUTDOWN_MS=30000
# Atomic cap for pending + claimed jobs. 0 disables it.
COLLECTOR_MAX_BACKLOG=10000
METRICS_HOST=127.0.0.1
METRICS_PORT=9091
METRICS_USER=
METRICS_PASS=
# Requests per minute per IP for the worker metrics/health server (0 disables the limit).
METRICS_RATE_LIMIT=600

# Dashboard: keep loopback unless behind a secured TLS reverse proxy.
# Credentials are required for all state-changing Dashboard operations, including loopback.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3001
DASHBOARD_USER=
DASHBOARD_PASS=
# Required together with credentials when DASHBOARD_HOST is non-loopback.
# Must match the browser Origin/Referer of mutating requests, without a trailing slash.
DASHBOARD_ORIGIN=
# Requests per minute per IP (0 disables the limit).
DASHBOARD_RATE_LIMIT=120

# Optional notification channels. Leave disabled until delivery is verified.
# TG_BOT_TOKEN= / TG_CHAT_ID= enable Telegram; WEBHOOK_URL enables the webhook channel.
TG_BOT_TOKEN=
TG_CHAT_ID=
WEBHOOK_URL=

LOG_LEVEL=info
LOG_DIR=logs

# Reply Guy module (official X API, no browser fingerprint evasion).
REPLY_API_HOST=127.0.0.1
REPLY_API_PORT=3002
# Generate a random JWT secret of at least 32 characters; do not commit it.
JWT_SECRET=
# Optional versioned keyring for safe rotation; defaults to existing MASTER_KEY.
# REPLY_ENCRYPTION_KEYS={"old":"64_hex_chars","new":"64_hex_chars"}
# REPLY_ACTIVE_KEY_ID=new
# Keep this fingerprint key stable across JWT/encryption-key rotations.
REPLY_PROXY_HASH_KEY=
# Draft generation is independent of publication. Explicit X approval is required.
REPLY_PUBLISH_ENABLED=false
REPLY_X_AI_APPROVAL_REF=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1/
LLM_API_KEY=
# Explicitly choose current models supported by your provider/account.
LLM_MODEL=
LLM_EMBEDDING_MODEL=
TELEGRAM_BOT_TOKEN=
REPLY_TELEGRAM_ALLOWED_IDS=
REPLY_API_URL=http://127.0.0.1:3002
REPLY_PUBLIC_URL=
# Dedicated Compose database password. URL-encode reserved characters if needed.
REPLY_DB_PASSWORD=

# Optional IP-based timezone/country lookup via ipapi.co (no credentials sent).
REPLY_PROXY_GEOLOCATION=false

# Current X field names; set tweets only for a legacy API contract.
REPLY_X_FIELD_DIALECT=posts

# Official X full-archive access, separate from Reply Guy publication.
X_ARCHIVE_BEARER_TOKEN=
ARCHIVE_RAW_DIR=data/archive/raw
# Bump when raw-response parsing/normalization behavior changes; unset uses "unversioned".
X_COLLECTOR_PARSER_VERSION=1
# Retention for raw capture files/metadata, in days (1–3650); verify against applicable X terms.
ARCHIVE_RAW_RETENTION_DAYS=90

# Stop raw writes before exhausting the computer disk.
ARCHIVE_MIN_FREE_GB=5

# Start one local worker from dashboard; false for external supervised workers.
COLLECTOR_AUTOSTART=true
# Optional executable override, used by both login and collector.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Scheduler reserves DB connections for lock holders and their queries.
SCHEDULER_CONCURRENCY=2
