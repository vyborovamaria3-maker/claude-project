    "prom-client": "^15.1.3",
    "vue": "^3.5.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.11.0",
