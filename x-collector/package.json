{
  "name": "claude-project-x-collector",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "install-browser": "playwright install chromium",
    "login": "tsx scripts/x-login.ts",
    "x:import": "tsx scripts/import-session.ts",
    "x:accounts": "tsx scripts/check-accounts.ts",
    "x:health": "tsx scripts/x-health.ts",
    "x:test": "tsx scripts/test-x.ts",
    "x:account:test": "tsx scripts/test-account-x.ts",
    "x:task:test": "tsx scripts/test-search-task.ts",
    "x:search:e2e": "tsx scripts/test-search-e2e.ts",
    "entities:test": "node --import tsx --test tests/entities.test.ts",
    "analytics:test": "node --import tsx --test tests/analytics.test.ts",
    "signals:test": "node --import tsx --test tests/signals.test.ts",
    "signals:report": "tsx scripts/signals-report.ts",
    "weighted:test": "node --import tsx --test tests/weighted-signals.test.ts",
    "graph:test": "node --import tsx --test tests/graph.test.ts",
    "graph:report": "tsx scripts/graph-report.ts",
    "kol:test": "node --import tsx --test tests/authors.test.ts",
    "kol:report": "tsx scripts/kol-report.ts",
    "entities:worker": "tsx scripts/entity-worker.ts",
    "enqueue-search": "tsx scripts/enqueue-search.ts",
    "enqueue-mints": "tsx scripts/enqueue-mints.ts",
    "worker": "tsx scripts/worker.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "dashboard": "tsx scripts/dashboard.ts",
    "publisher": "tsx scripts/outbox-publisher.ts",
    "outbox:publish": "tsx scripts/outbox-publisher.ts",
    "report": "tsx scripts/report.ts",
    "intelligence:report": "tsx scripts/intelligence-report.ts",
    "backtest": "tsx scripts/backtest.ts",
    "graph-export": "tsx scripts/graph-export.ts",
    "monitor": "tsx scripts/monitor.ts",
    "test:db": "node --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^18.0.0",
    "pg": "^8.16.3",
    "playwright": "^1.60.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
