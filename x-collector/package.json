    "backtest": "tsx scripts/backtest.ts",
    "graph-export": "tsx scripts/graph-export.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "chart.js": "^4.4.0",
    "dotenv": "^18.0.0",
    "pg": "^8.16.3",
