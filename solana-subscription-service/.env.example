# Common
NODE_ENV=development
APP_NAME=SolSub
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# PostgreSQL / Prisma
# docker-compose.prod.yml requires POSTGRES_PASSWORD explicitly.
POSTGRES_DB=solsub
POSTGRES_USER=solsub
POSTGRES_PASSWORD=replace-with-random-database-password
DATABASE_URL=postgresql://solsub:solsub@postgres:5432/solsub?schema=public

# Redis / BullMQ
# Production Compose requires a URL-safe random value (hex is recommended).
REDIS_PASSWORD=replace-with-url-safe-random-hex
REDIS_URL=redis://redis:6379

# JWT and cookies
# Access and refresh secrets must be different and at least 32 characters each.
JWT_ACCESS_SECRET=replace-with-64-char-random-secret
JWT_REFRESH_SECRET=replace-with-another-64-char-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_DOMAIN=
# Development override only. Production forces Secure cookies regardless of this value.
COOKIE_SECURE=false

# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_BOT_USERNAME=YourSubscriptionBot
TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-webhook-secret
TELEGRAM_WEBAPP_URL=http://localhost:3000

# Solana
SOLANA_CLUSTER=devnet
RPC_ENDPOINT=https://api.devnet.solana.com
TREASURY_WALLET=ReplaceWithTreasuryPublicKey
TREASURY_USDC_TOKEN_ACCOUNT=ReplaceWithTreasuryUsdcTokenAccount
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
PAYMENT_CONFIRMATION_COMMITMENT=confirmed

# Helius webhook
# If /webhooks/solana is enabled, configure a strong bearer token. The route fails closed when empty.
HELIUS_WEBHOOK_AUTH_TOKEN=replace-if-used

# Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourSubscriptionBot
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com
NEXT_PUBLIC_TREASURY_WALLET=ReplaceWithTreasuryPublicKey
