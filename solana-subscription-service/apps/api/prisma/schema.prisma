generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  BASIC
  ADVANCED
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  PENDING_PAYMENT
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum PaymentCurrency {
  SOL
  USDC
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum NotificationType {
  SUBSCRIPTION_CREATED
  PAYMENT_CONFIRMED
  RENEWAL_REMINDER
  SUBSCRIPTION_EXPIRED
  COMMAND_REPLY
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model User {
  /// Internal UUID generated by the API.
  id             String               @id @default(uuid())
  /// Telegram numeric user id as a string to avoid JS integer edge cases.
  telegramId     String               @unique
  /// Telegram username, if the account has one.
  telegramUsername String?
  /// Telegram first name from login widget or Mini App initData.
  firstName      String?
  /// Telegram last name from login widget or Mini App initData.
  lastName       String?
  /// Telegram avatar URL supplied by the login widget.
  photoUrl       String?
  /// Last successful Telegram authentication timestamp.
  lastLoginAt    DateTime             @default(now())
  /// Creation timestamp.
  createdAt      DateTime             @default(now())
  /// Last update timestamp.
  updatedAt      DateTime             @updatedAt
  /// Wallets linked by this user.
  wallets        Wallet[]
  /// Subscriptions owned by this user.
  subscriptions  Subscription[]
  /// Payment transactions created by this user.
  payments       PaymentTransaction[]
  /// Telegram notification audit log.
  notifications  NotificationLog[]

  @@index([telegramUsername])
}

model Wallet {
  /// Internal UUID generated by the API.
  id        String   @id @default(uuid())
  /// Owner user id.
  userId    String
  /// Solana base58 public key.
  publicKey String   @unique
  /// Whether this is the active wallet for payments and analytics.
  isPrimary Boolean  @default(true)
  /// Creation timestamp.
  createdAt DateTime @default(now())
  /// Last update timestamp.
  updatedAt DateTime @updatedAt
  /// Owning user relation.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SubscriptionPlan {
  /// Stable tier code used by the frontend and seed script.
  id             SubscriptionTier @id
  /// Human-readable plan name.
  name           String
  /// Marketing and dashboard description.
  description    String
  /// Monthly price denominated in SOL.
  monthlySol     Decimal          @db.Decimal(18, 9)
  /// Yearly price denominated in SOL.
  yearlySol      Decimal          @db.Decimal(18, 9)
  /// Feature list stored as JSON for simple display.
  features       Json
  /// Whether the plan can be purchased.
  isActive       Boolean          @default(true)
  /// Creation timestamp.
  createdAt      DateTime         @default(now())
  /// Last update timestamp.
  updatedAt      DateTime         @updatedAt
  /// Subscriptions using this plan.
  subscriptions  Subscription[]
  /// Payments initiated for this plan.
  payments       PaymentTransaction[]
}

model Subscription {
  /// Internal UUID generated by the API.
  id         String             @id @default(uuid())
  /// Owner user id.
  userId     String
  /// Current plan id.
  planId     SubscriptionTier
  /// Current subscription lifecycle status.
  status     SubscriptionStatus @default(PENDING_PAYMENT)
  /// Current billing period.
  period     BillingPeriod      @default(MONTHLY)
  /// Current paid access start.
  startsAt   DateTime?
  /// Current paid access end.
  endsAt     DateTime?
  /// Whether a three-day renewal reminder has already been sent.
  reminderSentAt DateTime?
  /// Creation timestamp.
  createdAt  DateTime           @default(now())
  /// Last update timestamp.
  updatedAt  DateTime           @updatedAt
  /// Owning user relation.
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Plan relation.
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])
  /// Payments that have activated or renewed this subscription.
  payments   PaymentTransaction[]

  @@index([userId, status])
  @@index([endsAt])
}

model PaymentTransaction {
  /// Internal UUID generated by the API.
  id             String             @id @default(uuid())
  /// Owner user id.
  userId         String
  /// Target subscription, filled when payment activates access.
  subscriptionId String?
  /// Plan requested by the payment.
  planId         SubscriptionTier
  /// Billing period requested by the payment.
  period         BillingPeriod
  /// Currency expected on-chain.
  currency       PaymentCurrency
  /// Exact expected amount in the selected currency.
  expectedAmount Decimal            @db.Decimal(18, 9)
  /// Unique nonce stored in the Solana memo field.
  nonce          String             @unique
  /// Solana transaction signature once provided or discovered.
  signature      String?            @unique
  /// Solana Pay deep link generated for wallets.
  paymentUrl     String
  /// Current verification status.
  status         PaymentStatus      @default(PENDING)
  /// Failure reason, if verification rejected the payment.
  failureReason  String?
  /// Expiration timestamp for the payment intent.
  expiresAt      DateTime
  /// Confirmation timestamp.
  confirmedAt    DateTime?
  /// Creation timestamp.
  createdAt      DateTime           @default(now())
  /// Last update timestamp.
  updatedAt      DateTime           @updatedAt
  /// Owning user relation.
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Plan relation.
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id])
  /// Subscription relation.
  subscription   Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([nonce])
  @@index([expiresAt])
}

model NotificationLog {
  /// Internal UUID generated by the API.
  id             String             @id @default(uuid())
  /// User id that received or should have received the notification.
  userId         String
  /// Notification category.
  type           NotificationType
  /// Delivery result.
  status         NotificationStatus
  /// Telegram chat id used for delivery.
  telegramChatId String
  /// Message text sent to Telegram.
  message        String
  /// Provider error or skip reason.
  error          String?
  /// Creation timestamp.
  createdAt      DateTime           @default(now())
  /// Owning user relation.
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([createdAt])
}
