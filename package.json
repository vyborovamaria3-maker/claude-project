    "x-collector:dashboard": "npm --prefix x-collector run dashboard",
    "x-collector:publisher": "npm --prefix x-collector run publisher",
    "x-collector:report": "npm --prefix x-collector run report --",
    "x-collector:intelligence:report": "npm --prefix x-collector run intelligence:report --",
    "x-collector:analytics:test": "npm --prefix x-collector run analytics:test",
    "x-collector:signals:test": "npm --prefix x-collector run signals:test",
    "x-collector:signals:report": "npm --prefix x-collector run signals:report",
    "x-collector:weighted:test": "npm --prefix x-collector run weighted:test",
