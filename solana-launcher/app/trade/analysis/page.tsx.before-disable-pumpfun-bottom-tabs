function KolOverviewCard({ mint }: { mint: string }) {
  const { locale: analysisLocale, t: analysisT } = useI18n();
  const [data, setData] = useState<KolOverviewResponse | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    fetch(`/api/trade/kols?mint=${encodeURIComponent(mint)}`, { cache: "no-store" })
      .then(async (response) => {
        const json = (await response.json()) as KolOverviewResponse;
        if (!cancelled) setData(json);
      })
      .catch(() => {
        if (!cancelled) setData(null);
      })
      .finally(() => {
        if (!cancelled) setLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, [mint]);

  const summary = useMemo(() => {
    const kol = data?.kolTrades ?? [];
    const smart = data?.smartMoneyTrades ?? [];
    const net = (rows: typeof kol) =>
      rows.reduce((sum, row) => {
        const amount = Number(row.amountUsd || 0);
        return sum + (row.side === "buy" ? amount : row.side === "sell" ? -amount : 0);
      }, 0);
    const unique = (rows: typeof kol) => new Set(rows.map((row) => row.maker).filter(Boolean)).size;
    return {
      kolCount: kol.length,
      smartCount: smart.length,
      kolNet: net(kol),
      smartNet: net(smart),
      kolWallets: unique(kol),
      smartWallets: unique(smart),
    };
  }, [data]);

  return (
    <section className="overflow-hidden rounded-2xl border border-bg-border bg-bg-card/60" data-tag="trade.analysis.overview.kols">
      <div className="flex items-center justify-between gap-3 border-b border-bg-border px-4 py-3">
        <div className="flex items-center gap-2">
          <Users className="h-4 w-4 text-primary" />
          <div><h2 className="text-sm font-semibold text-content">{analysisT("analysis.auto.6cf081f691be")}</h2><p className="text-[10px] text-content-faint">{analysisT("analysis.auto.5ff3967707d0")}</p></div>
        </div>
        <span className="text-[10px] text-content-faint">{loading ? "loading" : data?.configured ? analysisT("analysis.auto.d57a1fd55230") : analysisT("analysis.auto.b0af633e603d")}</span>
      </div>
      <div className="grid grid-cols-2 gap-2 p-4 md:grid-cols-4">
        <MiniMetric label={analysisT("analysis.auto.5ff7b75c4f96")} value={loading ? "…" : String(summary.kolCount)} />
        <MiniMetric label={analysisT("analysis.auto.dc58a7c475be")} value={loading ? "…" : String(summary.kolWallets)} />
        <MiniMetric label={analysisT("analysis.auto.4acc6fc73cb3")} value={loading ? "…" : String(summary.smartCount)} />
        <MiniMetric label={analysisT("analysis.auto.2a864301333b")} value={loading ? "…" : String(summary.smartWallets)} />
        <div className="col-span-2"><MiniMetric label={analysisT("analysis.auto.4bcb7d8433c0")} value={loading ? "…" : formatUsd(summary.kolNet)} /></div>
        <div className="col-span-2"><MiniMetric label={analysisT("analysis.auto.c75cf98d1a0d")} value={loading ? "…" : formatUsd(summary.smartNet)} /></div>
      </div>
      {!loading && summary.kolCount === 0 && summary.smartCount === 0 && (
        <div className="mx-4 mb-4 rounded-xl border border-dashed border-bg-border px-3 py-3 text-[11px] text-content-faint">
          {analysisT("analysis.auto.21e5318147e0")}
        </div>
      )}
    </section>
  );
}

function MiniMetric({ label, value }: { label: string; value: string }) {
  return (
    <div className="rounded-xl border border-bg-border bg-bg-elevated/35 px-3 py-2.5">
      <div className="text-[9px] uppercase tracking-wide text-content-faint">{label}</div>
      <div className="mt-1 font-mono text-sm font-semibold text-content">{value}</div>
    </div>
  );
}

function formatUsd(value: number) {
  const sign = value > 0 ? "+" : value < 0 ? "-" : "";
  return `${sign}$${Math.abs(value).toLocaleString(undefined, {
    maximumFractionDigits: Math.abs(value) >= 1000 ? 0 : 2,
  })}`;
}

function PanelLoading({ text, tall = false }: { text: string; tall?: boolean }) {
  return (
    <div className={`glass flex items-center justify-center rounded-2xl border border-bg-border text-sm text-content-faint ${tall ? "h-[520px]" : "min-h-28 p-6"}`}>
      {text}
    </div>
  );
}
