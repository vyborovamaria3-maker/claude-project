type AnalysisTab = "overview" | "blockchain" | "telegram" | "twitter" | "kols" | "ai";

type KolOverviewResponse = {
  available?: boolean;
  configured?: boolean;
  kolTrades?: Array<{ side?: string; amountUsd?: number | null; maker?: string | null }>;
  smartMoneyTrades?: Array<{ side?: string; amountUsd?: number | null; maker?: string | null }>;
  errors?: string[];
};

const TABS: Array<{
  id: AnalysisTab;
  label: string;
  shortLabel: string;
  subtitle: string;
  icon: typeof LayoutDashboard;
}> = [
  { id: "overview", label: "Обзор", shortLabel: "Обзор", subtitle: "Сводка", icon: LayoutDashboard },
  { id: "blockchain", label: "Блокчейн", shortLabel: "Chain", subtitle: "V3.4 · V3.5 · DEV · AI", icon: Activity },
  { id: "telegram", label: "Telegram", shortLabel: "TG", subtitle: "Каналы · Calls", icon: Send },
  { id: "twitter", label: "X / Twitter", shortLabel: "X", subtitle: "Posts · KOLs", icon: Twitter },
  { id: "kols", label: "KOLs / Smart Money", shortLabel: "KOLs", subtitle: "GMGN", icon: Users },
  { id: "ai", label: "AI / EE", shortLabel: "AI", subtitle: "Cross-source", icon: BrainCircuit },
];

function normalizeTab(value: string | null): AnalysisTab {
  return TABS.some((tab) => tab.id === value) ? (value as AnalysisTab) : "overview";
}

function buildAnalysisUrl(mint: string, tab: AnalysisTab) {
  const query = new URLSearchParams();
  if (mint.trim()) query.set("mint", mint.trim());
  query.set("tab", tab);
  return `/trade/analysis?${query.toString()}`;
}

export default function TradeAnalysisPage() {
  const { locale: analysisLocale, t: analysisT } = useI18n();
  const router = useRouter();
  const params = useSearchParams();
  const urlMint = params.get("mint")?.trim() || "";
  const activeTab = normalizeTab(params.get("tab"));
  const [mint, setMint] = useState(urlMint);
  const [refreshKey, setRefreshKey] = useState(0);

  useEffect(() => {
    setMint(urlMint);
  }, [urlMint]);

  const runSearch = (nextMint: string) => {
    const normalized = nextMint.trim();
    setMint(normalized);
    router.replace(buildAnalysisUrl(normalized, activeTab), { scroll: false });
  };

  const changeTab = (tab: AnalysisTab) => {
    router.replace(buildAnalysisUrl(mint, tab), { scroll: false });
  };

  return (
    <div className="space-y-4" data-tag="trade.analysis.tabs.page.v2">
      <header className="overflow-hidden rounded-2xl border border-bg-border bg-gradient-to-r from-bg-card via-bg-card to-primary/5">
        <div className="flex flex-col gap-3 p-4 xl:flex-row xl:items-center xl:justify-between">
          <div className="flex items-start gap-3">
            <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/25 bg-primary/10">
              <TrendingUp className="h-5 w-5 text-primary" />
            </div>
            <div>
              <h1 className="text-base font-semibold text-content sm:text-lg">{analysisT("analysis.auto.1a2b7398f859")}</h1>
              <p className="mt-1 text-[11px] leading-5 text-content-faint">
                {analysisT("analysis.auto.6ff7304c2036")}
              </p>
            </div>
          </div>
          {mint && (
            <div className="rounded-lg border border-bg-border bg-bg-card/70 px-3 py-2 font-mono text-[10px] text-content-faint">
              {mint.slice(0, 8)}…{mint.slice(-7)}
            </div>
          )}
        </div>
      </header>

      <div className="flex items-stretch gap-2">
        <div className="min-w-0 flex-1">
          <SearchBar onSearch={runSearch} isLoading={false} initialValue={mint} />
        </div>
        {mint && (
          <button
            type="button"
            onClick={() => setRefreshKey((value) => value + 1)}
            title={analysisT("analysis.auto.e28f42ae12bc")}
            className="flex items-center rounded-xl border border-bg-border bg-bg-card px-3 text-content-muted transition hover:border-primary/20 hover:bg-primary/5 hover:text-content"
          >
            <RefreshCw className="h-4 w-4" />
          </button>
        )}
      </div>

      <AnalysisTabs activeTab={activeTab} onChange={changeTab} disabled={!mint} />

      {!mint ? (
        <div className="glass rounded-2xl border border-bg-border py-20 text-center text-sm text-content-faint">
          {analysisT("analysis.auto.bb3c386a4f3e")}
        </div>
      ) : (
        <main key={`${activeTab}:${mint}:${refreshKey}`} className="space-y-4">
          {activeTab === "overview" && <OverviewTab mint={mint} />}
          {activeTab === "blockchain" && <BlockchainTab mint={mint} />}
          {activeTab === "telegram" && (
            <SocialIntelligencePanel mintOverride={mint} compact compactMode="telegram" />
          )}
          {activeTab === "twitter" && (
            <SocialIntelligencePanel mintOverride={mint} compact compactMode="twitter" />
          )}
          {activeTab === "kols" && <KolsTab mint={mint} />}
          {activeTab === "ai" && (
            <SocialIntelligencePanel mintOverride={mint} compact compactMode="ai" />
          )}
        </main>
      )}
    </div>
  );
}

function AnalysisTabs({
  activeTab,
  onChange,
  disabled,
}: {
  activeTab: AnalysisTab;
  onChange: (tab: AnalysisTab) => void;
  disabled: boolean;
}) {
  const { locale: analysisLocale, t: analysisT } = useI18n();
  return (
    <nav
      className="grid grid-cols-2 gap-2 rounded-2xl border border-bg-border bg-bg-card/70 p-2 md:grid-cols-3 xl:grid-cols-6"
      aria-label={analysisT("analysis.auto.b7f48bd7a8b6")}
      data-tag="trade.analysis.tabs.v2"
    >
      {TABS.map((tab) => {
        const Icon = tab.icon;
        const active = activeTab === tab.id;
        return (
          <button
            key={tab.id}
            type="button"
            disabled={disabled}
            onClick={() => onChange(tab.id)}
            aria-current={active ? "page" : undefined}
            className={`group relative min-w-0 overflow-hidden rounded-xl border px-3 py-2.5 text-left transition ${
              active
                ? "border-primary/35 bg-gradient-to-br from-primary/15 to-primary/5 text-content shadow-sm"
                : "border-transparent bg-bg-elevated/30 text-content-muted hover:border-bg-border hover:bg-bg-elevated/70 hover:text-content"
            } disabled:cursor-not-allowed disabled:opacity-40`}
          >
            {active && <span className="absolute inset-x-3 bottom-0 h-0.5 rounded-full bg-primary" />}
            <div className="flex items-center gap-2">
              <div className={`flex h-7 w-7 shrink-0 items-center justify-center rounded-lg ${active ? "bg-primary/15 text-primary" : "bg-white/5 text-content-faint group-hover:text-content-muted"}`}>
                <Icon className="h-3.5 w-3.5" />
              </div>
              <div className="min-w-0">
                <div className="truncate text-[11px] font-semibold sm:text-xs">
                  <span className="hidden sm:inline">{tab.label}</span>
                  <span className="sm:hidden">{tab.shortLabel}</span>
                </div>
                <div className="hidden truncate text-[9px] text-content-faint lg:block">{tab.subtitle}</div>
              </div>
            </div>
          </button>
        );
      })}
    </nav>
  );
}

