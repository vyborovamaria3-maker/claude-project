# Docker Compose deployment settings.
# Copy this file to .env and fill every required blank before starting.
# Required blanks are intentionally empty so Compose fails closed instead of
# starting with a source-controlled placeholder credential.
# Use URL-safe random values (for example: openssl rand -hex 32) for service passwords.

ENVIRONMENT=production
DEBUG=false

POSTGRES_DB=potapoff
POSTGRES_USER=potapoff
POSTGRES_PASSWORD=

REDIS_PASSWORD=

RABBITMQ_USER=potapoff
RABBITMQ_PASSWORD=

# Scoped server-to-server credential used only by the KOL frontend proxy/backend endpoints.
# Generate a separate random value; do not reuse BACKEND_API_KEY or expose it as NEXT_PUBLIC_*.
KOL_INTERNAL_KEY=

# Optional KOL on-chain trade ingestion. Without the key the feature stays fail-open
# with explicit `ingestion_disabled` coverage instead of pretending wallets were inactive.
SOLANA_TRACKER_API_KEY=
SOLANA_TRACKER_API_BASE=https://data.solanatracker.io
# Conservative defaults: one least-recently-synced wallet per 20-minute Beat run.
# Increase only after checking the provider quota for the configured API key.
KOL_TRADE_SYNC_INTERVAL_SECONDS=1200
KOL_TRADE_SYNC_WALLETS_PER_RUN=1

# Public application URLs. Keep backend/frontend containers private; nginx is the public ingress.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_BACKEND_URL=
BACKEND_URL=http://backend:8000

# Optional integrations used by the frontend container.
MEMECOIN_INTELLIGENCE_URL=http://host.docker.internal:3001
MEMECOIN_INTELLIGENCE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/Soft777bot

# Optional Jupiter Swap API credentials for server-side execution preflight.
# With JUPITER_API_KEY the app uses https://api.jup.ag/swap/v1.
# Without a key it falls back to the low-rate keyless endpoint.
JUPITER_API_KEY=
# JUPITER_SWAP_API_URL=https://api.jup.ag/swap/v1
# JUPITER_QUOTE_MIN_INTERVAL_MS=120

# Local-only TG Collector panel/API.
# Never expose these as NEXT_PUBLIC_* variables.
TG_COLLECTOR_ADMIN_TOKEN=
# Direct PostgreSQL connection, using the same database as tg-collector/DATABASE_URL.
TG_COLLECTOR_DATABASE_URL=
# Must match the worker key. Alternatively set the same TG_API_HASH in both processes.
TG_PROXY_ENCRYPTION_KEY=
TG_API_HASH=

# Optional trusted local browser connection without typing the admin token.
# Development only; bind Next to loopback and set the exact browser origin.
TG_COLLECTOR_LOCAL_AUTO_CONNECT=0
TG_COLLECTOR_LOCAL_ORIGIN=http://127.0.0.1:3000

# ARCH-11 Token Intelligence UI -> local Intelligence API (server-side only).
# OFF by default. Both the Next.js server and Intelligence API must run on
# the SAME local machine/network namespace; 127.0.0.1 inside a Docker
# container refers to that container, NOT the Windows laptop.
# Do not reuse the admin/KOL/BACKEND key or use NEXT_PUBLIC_* for the secret.
# Enable only after Intelligence DB migrations 001, 002, 004 + read-only role.
POTAPOFF_TOKEN_INTELLIGENCE_ENABLED=false
# Secret must match intelligence/INTELLIGENCE_API_TOKEN (32-128 base64url).
INTELLIGENCE_API_TOKEN=
INTELLIGENCE_API_PORT=3182
