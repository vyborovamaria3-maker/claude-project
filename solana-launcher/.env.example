# Docker Compose deployment settings.
# Copy this file to .env and fill every required blank before starting.
# Required blanks are intentionally empty so Compose fails closed instead of
# starting with a source-controlled placeholder credential.
# Use URL-safe random values (for example: openssl rand -hex 32) for service passwords.

ENVIRONMENT=production
DEBUG=false

POSTGRES_DB=potapoff
POSTGRES_USER=potapoff
POSTGRES_PASSWORD=

REDIS_PASSWORD=

RABBITMQ_USER=potapoff
RABBITMQ_PASSWORD=

# Public application URLs. Keep backend/frontend containers private; nginx is the public ingress.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_BACKEND_URL=
BACKEND_URL=http://backend:8000

# Helius / Solana chain analysis. Configure at least HELIUS_API_KEY or a Helius
# RPC URL containing ?api-key=. HELIUS_API_KEYS can hold comma-separated keys for rotation.
HELIUS_API_KEY=
HELIUS_API_KEYS=
HELIUS_RPC_URL=
NEXT_PUBLIC_HELIUS_RPC_URL=

# Optional historical chart provider. Pump.fun/GeckoTerminal are used as fallbacks.
BITQUERY_API_KEY=

# Optional integrations used by the frontend container.
MEMECOIN_INTELLIGENCE_URL=http://host.docker.internal:3001
MEMECOIN_INTELLIGENCE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/Soft777bot
