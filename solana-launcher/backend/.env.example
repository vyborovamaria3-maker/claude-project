APP_NAME=POTAPoff API
ENVIRONMENT=development
# Production startup requires DEBUG=false.
DEBUG=true
SECRET_KEY=8f2c4a7e9b1d3c6f5a8e0d2b4c7f9a1e6d3b5c8a2f4e7d1
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://potapoff:potapoff@postgres:5432/potapoff
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Production rejects wildcard CORS origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ADMIN_USERNAME=admin@potapoff.local
# Development-only default below. Production startup rejects this value and
# requires an explicit ADMIN_PASSWORD of at least 16 characters.
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=POTAPoff Admin
# Development example. Production requires an explicit non-default secret of
# at least 32 characters. Generate it outside the repository, e.g. openssl rand -hex 32.
ADMIN_SESSION_SECRET=1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4
FRONTEND_URL=http://localhost:3000
FRONTEND_INTERNAL_URL=http://frontend:3000
REDIS_CACHE_DB=2
PUMPFUN_API_BASE=https://frontend-api.pump.fun
RAYDIUM_API_BASE=https://api.raydium.io/v3
BIRDEYE_API_BASE=https://public-api.birdeye.so
BIRDEYE_API_KEY=
HELIUS_RPC_URL=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=
PUMPPORTAL_WS_URL=
HELIUS_WS_URL=
COLLECTOR_REFRESH_SECONDS=300
COLLECTOR_METRIC_REFRESH_SECONDS=3600
COLLECTOR_INSIDER_REFRESH_SECONDS=86400
TELEGRAM_BOT_TOKEN=
# Telegram Intelligence primary mode uses a user MTProto session, not the bot token.
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
TG_SESSION_PATH=data/telegram-intelligence
TG_MONITOR_CHANNELS=
TG_AUTOSTART=false
TG_HISTORY_LIMIT=300
TG_GRAPH_DEPTH=1
TG_ENTITY_LIMIT=100
TG_EVALUATE_INTERVAL_SECONDS=300
# Public-web fallback. It only covers configured public t.me/s channels and does not cover private groups.
# TG_PUBLIC_WEB_CHANNELS falls back to TG_MONITOR_CHANNELS when left empty.
TG_PUBLIC_WEB_ENABLED=false
TG_PUBLIC_WEB_CHANNELS=
TG_PUBLIC_WEB_HISTORY_LIMIT=100
TG_PUBLIC_WEB_TIMEOUT_SECONDS=12
# Bounded public-web graph discovery. Only explicit t.me links are expanded.
TG_PUBLIC_WEB_DISCOVERY_ENABLED=true
TG_PUBLIC_WEB_DISCOVERY_DEPTH=2
TG_PUBLIC_WEB_DISCOVERY_ENTITY_LIMIT=25
TG_PUBLIC_WEB_DISCOVERY_HISTORY_LIMIT=40
TG_PUBLIC_WEB_RELEVANCE_MIN_SCORE=35
# Historical TGDataset candidates produced by app.cli.tgdataset_filter.
# The collector revalidates these against current public posts before accepting them.
TG_PUBLIC_WEB_SEED_DATABASE=data/tgdataset/telegram_seed_database.json
TG_PUBLIC_WEB_SEED_DATABASE_LIMIT=12
# Background refresh uses the persistent TelegramChannel.meta discovery registry.
# Strong validated callers refresh more often; rejected/dead channels are backed off.
TG_PUBLIC_WEB_REFRESH_ENABLED=true
TG_PUBLIC_WEB_REFRESH_TICK_SECONDS=60
TG_PUBLIC_WEB_REFRESH_BATCH_SIZE=25
TG_PUBLIC_WEB_REFRESH_STRONG_SECONDS=600
TG_PUBLIC_WEB_REFRESH_NORMAL_SECONDS=1800
TG_PUBLIC_WEB_REFRESH_REJECTED_SECONDS=21600
TG_PUBLIC_WEB_REFRESH_UNAVAILABLE_SECONDS=3600

# Intelligence ingestion/research credential. Keep it backend-only.
# Production requires at least 32 random characters.
BACKEND_API_KEY=
# Mini App checkout/order credential. The public Next.js container receives this
# one key only; it cannot mutate subscription prices or wallet settings.
SUBSCRIPTION_INTERNAL_KEY=
# Main-admin credential for subscription settings. Keep it out of the frontend
# container and make it distinct from both keys above.
SUBSCRIPTION_ADMIN_KEY=
# Enable these only on the FastAPI API service. Worker processes should leave
# both false so they do not need either subscription credential.
REQUIRE_SUBSCRIPTION_INTERNAL_KEY=false
REQUIRE_SUBSCRIPTION_ADMIN_KEY=false
