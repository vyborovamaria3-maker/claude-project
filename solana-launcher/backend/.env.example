# Application environment template.
# Copy to backend/.env and fill required secrets locally. This file is intentionally
# non-runnable with production settings until secrets are supplied.

APP_NAME=POTAPoff API
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
API_V1_PREFIX=/api/v1

# Docker Compose injects these service URLs from solana-launcher/.env.
# Fill them only when running the backend outside Compose.
DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
REDIS_CACHE_DB=2

# Production rejects wildcard CORS origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Admin provisioning is performed only in production and requires explicit strong secrets.
ADMIN_USERNAME=admin@potapoff.local
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=POTAPoff Admin
ADMIN_SESSION_SECRET=

FRONTEND_URL=http://localhost:3000
FRONTEND_INTERNAL_URL=http://frontend:3000

PUMPFUN_API_BASE=https://frontend-api.pump.fun
RAYDIUM_API_BASE=https://api.raydium.io/v3
BIRDEYE_API_BASE=https://public-api.birdeye.so
BIRDEYE_API_KEY=
HELIUS_RPC_URL=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=
PUMPPORTAL_WS_URL=
HELIUS_WS_URL=
COLLECTOR_REFRESH_SECONDS=300
COLLECTOR_METRIC_REFRESH_SECONDS=3600
COLLECTOR_INSIDER_REFRESH_SECONDS=86400

TELEGRAM_BOT_TOKEN=
# Telegram Intelligence primary mode uses a user MTProto session, not the bot token.
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
TG_SESSION_PATH=data/telegram-intelligence
TG_MONITOR_CHANNELS=
TG_AUTOSTART=false
TG_HISTORY_LIMIT=300
TG_GRAPH_DEPTH=1
TG_ENTITY_LIMIT=100
TG_EVALUATE_INTERVAL_SECONDS=300

# Public-web fallback. It only covers configured public t.me/s channels and does not cover private groups.
# TG_PUBLIC_WEB_CHANNELS falls back to TG_MONITOR_CHANNELS when left empty.
TG_PUBLIC_WEB_ENABLED=false
TG_PUBLIC_WEB_CHANNELS=
TG_PUBLIC_WEB_HISTORY_LIMIT=100
TG_PUBLIC_WEB_TIMEOUT_SECONDS=12
TG_PUBLIC_WEB_DISCOVERY_ENABLED=true
TG_PUBLIC_WEB_DISCOVERY_DEPTH=2
TG_PUBLIC_WEB_DISCOVERY_ENTITY_LIMIT=25
TG_PUBLIC_WEB_DISCOVERY_HISTORY_LIMIT=40
TG_PUBLIC_WEB_RELEVANCE_MIN_SCORE=35
TG_PUBLIC_WEB_SEED_DATABASE=data/tgdataset/telegram_seed_database.json
# Where the TeraGram scanner writes the seed database consumed by the TG Invite source card.
TG_TERAGRAM_OUTPUT_DIR=data/teragram
TG_PUBLIC_WEB_SEED_DATABASE_LIMIT=12
TG_PUBLIC_WEB_REFRESH_ENABLED=true
TG_PUBLIC_WEB_REFRESH_TICK_SECONDS=60
TG_PUBLIC_WEB_REFRESH_BATCH_SIZE=25
TG_PUBLIC_WEB_REFRESH_STRONG_SECONDS=600
TG_PUBLIC_WEB_REFRESH_NORMAL_SECONDS=1800
TG_PUBLIC_WEB_REFRESH_REJECTED_SECONDS=21600
TG_PUBLIC_WEB_REFRESH_UNAVAILABLE_SECONDS=3600

# Backend-only credentials. Generate independent random values; never reuse them.
# Production requires BACKEND_API_KEY and SUBSCRIPTION_PASSWORD_ENCRYPTION_KEY to be >=32 characters.
BACKEND_API_KEY=
SUBSCRIPTION_PASSWORD_ENCRYPTION_KEY=

# Mini App checkout/order credential. Keep it distinct from BACKEND_API_KEY.
SUBSCRIPTION_INTERNAL_KEY=
# Main-admin credential. Never inject it into the public frontend container.
SUBSCRIPTION_ADMIN_KEY=
# Enable these only on the FastAPI API service when the corresponding functionality is used.
REQUIRE_SUBSCRIPTION_INTERNAL_KEY=false
REQUIRE_SUBSCRIPTION_ADMIN_KEY=false
