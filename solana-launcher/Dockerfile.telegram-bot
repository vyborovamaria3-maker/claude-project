FROM node:22-bookworm-slim AS builder

# Keep the image runtime aligned with solana-launcher's engines.node >=22.
RUN node -e "if (Number(process.versions.node.split('.')[0]) < 22) throw new Error('Telegram bot requires Node.js 22 or newer')"

WORKDIR /app

ENV PYTHON=/usr/bin/python3 \
    npm_config_python=/usr/bin/python3 \
    npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_maxsockets=5

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY scripts/bigint-safe-package ./scripts/bigint-safe-package
COPY scripts/xlsx-safe-package ./scripts/xlsx-safe-package

RUN set -eux; \
    for attempt in 1 2 3; do \
      if npm ci --legacy-peer-deps; then \
        break; \
      fi; \
      if [ "$attempt" -eq 3 ]; then \
        exit 1; \
      fi; \
      echo "npm ci failed (attempt ${attempt}/3); retrying" >&2; \
      sleep $((attempt * 20)); \
    done; \
    npm rebuild better-sqlite3 --build-from-source

# Compile the bot and its local TypeScript dependencies before removing build-only packages.
COPY . .
RUN rm -rf dist && npm run bot:build

# Keep devDependencies out of the image that is shipped and scanned.
RUN npm prune --omit=dev --legacy-peer-deps \
    && test ! -e node_modules/figma-mcp \
    && test ! -e node_modules/ts-node \
    && test ! -e node_modules/typescript

FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production \
    TELEMETRY_DISABLED=1

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
# bigint-buffer is a local file dependency and remains a symlink in node_modules.
COPY --from=builder --chown=node:node /app/scripts/bigint-safe-package ./scripts/bigint-safe-package

RUN mkdir -p /app/data && chown -R node:node /app/data

# npm/corepack are build-only tooling and are not needed by the compiled runtime.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    && ! command -v npm \
    && ! command -v npx

USER node
CMD ["node", "dist/telegram-bot/index.js"]
