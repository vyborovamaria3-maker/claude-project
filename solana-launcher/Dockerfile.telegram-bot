FROM node:22-bookworm-slim AS dependencies

# Keep the image runtime aligned with solana-launcher's engines.node >=22.
RUN node -e "if (Number(process.versions.node.split('.')[0]) < 22) throw new Error('Telegram bot requires Node.js 22 or newer')"

WORKDIR /app

ENV PYTHON=/usr/bin/python3 \
    npm_config_python=/usr/bin/python3 \
    npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_maxsockets=5

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

RUN set -eux; \
    for attempt in 1 2 3; do \
      if npm ci --legacy-peer-deps; then \
        break; \
      fi; \
      if [ "$attempt" -eq 3 ]; then \
        exit 1; \
      fi; \
      echo "npm ci failed (attempt ${attempt}/3); retrying" >&2; \
      sleep $((attempt * 20)); \
    done; \
    npm rebuild better-sqlite3 --build-from-source

FROM dependencies AS runner

WORKDIR /app

ENV NODE_ENV=production \
    TELEMETRY_DISABLED=1

COPY . .

USER node
CMD ["npm", "run", "bot:start"]
