# RPC Configuration
# Use private RPC for better reliability (Helius, QuickNode, or Triton)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Main wallets (3-5 master wallets that will fund child wallets)
# Format: base58 private keys separated by commas
# These should be funded wallets from different sources (exchange, personal, etc.)
PRIVATE_KEYS=your_first_wallet_private_key_base58_here,your_second_wallet_private_key_base58_here,your_third_wallet_private_key_base58_here

# Anti-detect: Number of child wallets to create per master wallet
WALLETS_PER_MASTER=3

# Minimum delay between actions (in seconds) - 1 hour default
MIN_DELAY_SECONDS=3600

# Maximum delay between actions (in seconds) - 48 hours default
MAX_DELAY_SECONDS=172800

# Simulation mode (true = no real transactions, only logs)
SIMULATE=false

# Optional: Jupiter API key for better swap routing
JUPITER_API_KEY=optional_jupiter_api_key

# Optional: Helius API key for enhanced RPC
HELIUS_API_KEY=your_helius_key_here
