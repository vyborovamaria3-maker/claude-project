# Helius RPC URL — REQUIRED for Confidential transfers (Light Protocol / ZK Compression).
# Sign up at https://www.helius.dev/ and create an API key.
# Devnet:
# NEXT_PUBLIC_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
# Mainnet:
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
# Beta (Gatekeeper):
# NEXT_PUBLIC_HELIUS_RPC_URL=https://beta.helius-rpc.com/?api-key=YOUR_API_KEY

# Optional fallback RPC for non-confidential transfers (defaults to mainnet-beta).
# NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Server-side RPC used to verify subscription payments on-chain.
# Prefer a dedicated mainnet RPC. If omitted, the app falls back to the public RPC variables above.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

BACKEND_URL=http://localhost:8000
SOLSCAN_API_TOKEN=your_solscan_api_token_here
BITQUERY_API_KEY=your_bitquery_api_key_here
LINGODOTDEV_API_KEY=your_lingodotdev_api_key_here
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_SANDBOX_ACTOR_ID=apify/ai-sandbox
APIFY_PUMPFUN_SCRAPER_ACTOR_ID=parseforge/pump-fun-scraper

# Unified Social Analysis -> memecoin-intelligence/Qwen server-side bridge.
# Local host process uses localhost:3001. In production Compose the frontend gets
# the private Docker DNS URL memecoin-intelligence-api:3001 automatically.
MEMECOIN_INTELLIGENCE_URL=http://localhost:3001
# Needed only when memecoin-intelligence has API access control enabled. Keep it
# server-only; never use a NEXT_PUBLIC_ prefix. Match its scoped user API key.
MEMECOIN_INTELLIGENCE_API_KEY=

# Vybe API Key — OPTIONAL for enhanced OHLC data and token metadata.
# Sign up at https://vybenetwork.com/pricing to get your API key
# VYBE_API_KEY=your_vybe_api_key_here

# Telegram Bot — REQUIRED for Telegram bot functionality
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_URL=https://your-app.example.com/api/telegram/webhook
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_bot
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Optional SOCKS proxy for Telegram Bot API egress.
# Example only; never commit real proxy credentials.
# TELEGRAM_PROXY_URL=socks5h://user:password@proxy.example.com:1080

# Subscription price, free-demo mode, demo duration, and the Solana recipient wallet
# are edited in the main admin panel under Subscription / Mini App.
# USDT payments use the canonical USDT mint on Solana mainnet.

# Security Configuration
# Comma-separated list of trusted proxy IPs (e.g., "10.0.0.1,10.0.0.2")
# Only these IPs are trusted for X-Forwarded-For headers
TRUSTED_PROXIES=

# Mini App checkout/order key used by server-side Next.js routes.
# Generate independently with: openssl rand -hex 32
# Never reuse BACKEND_API_KEY or SUBSCRIPTION_ADMIN_KEY here.
SUBSCRIPTION_INTERNAL_KEY=your_strong_subscription_internal_key_here

# BACKEND_API_KEY is an intelligence/backend-only master credential and must not
# be placed in the public-facing Next.js environment. SUBSCRIPTION_ADMIN_KEY is
# likewise backend/admin-only and must never be placed here.

# JWT Secret for token signing and server-side credential encryption (REQUIRED, min 32 chars)
# Generate with: openssl rand -hex 32
SECRET_KEY=your_strong_jwt_secret_here_min_32_chars
