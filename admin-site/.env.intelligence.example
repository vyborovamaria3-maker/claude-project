# POTAPoff Intelligence worker-only environment.
# Copy to admin-site/.env.intelligence on the server.
# This file is loaded ONLY by the intelligence-worker service.

# sqlite | postgres
POTAPOFF_INTELLIGENCE_BACKEND=sqlite

# Used only when POTAPOFF_INTELLIGENCE_BACKEND=postgres.
# Use a dedicated worker role with only the schema/job/document permissions it needs.
# Never reuse this DSN as ADMIN_INTELLIGENCE_POSTGRES_DSN.
POTAPOFF_INTELLIGENCE_POSTGRES_DSN=

# Optional provider credentials should be added here individually as providers require them.
# Do not copy the admin site's .env into this worker environment.
# GITHUB_TOKEN=
