# Explicit allowlist for the admin container runtime environment.
# deploy/refresh-runtime-env.sh copies only matching keys from .env to .env.runtime.
# Do not copy this file manually or add bootstrap, migrator, backup or provisioner secrets.
#
# Compose injects ADMIN_STATE_POSTGRES_DSN and
# POTAPOFF_SUBSCRIPTION_ADMIN_KEY from admin-site/.env.

ADMIN_APP_NAME=POTAPoff Administrator
ADMIN_ENVIRONMENT=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_COOKIE=potapoff_admin_session
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_IDLE_TIMEOUT_SECONDS=900
ADMIN_SECURE_COOKIE=true

ADMIN_REQUIRE_MFA=true
ADMIN_TOTP_SECRET=
ADMIN_REQUIRE_REAUTH=true
ADMIN_REAUTH_TTL_SECONDS=300
ADMIN_SESSION_BIND_IP=true
ADMIN_SESSION_BIND_USER_AGENT=true
ADMIN_REQUIRE_NETWORK_ALLOWLIST=true

ADMIN_SOURCES_FILE=/config/sources.json
ADMIN_LOGS_FILE=/config/logs.json
ADMIN_AUDIT_DB=/var/lib/potapoff-admin/audit.db
ADMIN_WEB_WORKERS=1
ADMIN_TASK_WORKERS=2
ADMIN_TASK_QUEUE_MAX=1000
ADMIN_TASK_HISTORY_MAX=5000
ADMIN_PG_POOL_MIN=1
ADMIN_PG_POOL_MAX=6
ADMIN_PG_POOL_WAIT_SECONDS=2
ADMIN_PG_POOL_MAX_IDLE_SECONDS=300
ADMIN_PG_POOL_MAX_LIFETIME_SECONDS=1800

ADMIN_ALLOWED_NETWORKS=
ADMIN_MAX_PAGE_SIZE=250
ADMIN_MAX_EXPORT_ROWS=10000
ADMIN_SHOW_SENSITIVE=false
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

ADMIN_TWITTER_BACKEND_URL=http://backend:8000
TWITTER_CRAWLER_ADMIN_KEY=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Read-only Intelligence Control Center connection only.
ADMIN_INTELLIGENCE_BACKEND=sqlite
ADMIN_INTELLIGENCE_POSTGRES_DSN=

# Dedicated read-only product database credentials referenced by sources.json.
# Subscription/Memecoin values must match POSTGRES_READONLY_PASSWORD in their stack .env.
POTAPOFF_DB_READONLY_PASSWORD=
SUBSCRIPTION_DB_READONLY_PASSWORD=
MEMECOIN_DB_READONLY_PASSWORD=

ADMIN_TRUST_PROXY=true
ADMIN_TRUSTED_PROXY_HOPS=1
ADMIN_ALLOWED_ORIGINS=https://admin.potapoff.fun
ADMIN_X_COLLECTOR_DSN=
