ADMIN_APP_NAME=POTAPoff Administrator
ADMIN_ENVIRONMENT=production
ADMIN_USERNAME=admin
# Generate: docker compose run --rm admin python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -hex 48
ADMIN_SESSION_SECRET=
# Absolute session lifetime. Idle timeout below is stricter.
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_IDLE_TIMEOUT_SECONDS=900
ADMIN_SECURE_COOKIE=true

# Strong admin security. Keep enabled in production.
ADMIN_REQUIRE_MFA=true
# Generate: docker compose run --rm admin python scripts/generate_totp_secret.py
ADMIN_TOTP_SECRET=
ADMIN_REQUIRE_REAUTH=true
ADMIN_REAUTH_TTL_SECONDS=300
ADMIN_SESSION_BIND_IP=true
ADMIN_SESSION_BIND_USER_AGENT=true
ADMIN_REQUIRE_NETWORK_ALLOWLIST=true

ADMIN_SOURCES_FILE=/config/sources.json
ADMIN_LOGS_FILE=/config/logs.json
ADMIN_AUDIT_DB=/var/lib/potapoff-admin/audit.db
# Required with ADMIN_REQUIRE_NETWORK_ALLOWLIST=true, e.g. YOUR.PUBLIC.IP/32 or VPN CIDR.
ADMIN_ALLOWED_NETWORKS=
ADMIN_MAX_PAGE_SIZE=250
ADMIN_MAX_EXPORT_ROWS=10000
ADMIN_SHOW_SENSITIVE=false
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Intelligence Control Center read model.
# SQLite is the single-host default. For PostgreSQL use ONLY a SELECT-only role here.
# The worker write DSN belongs in .env.intelligence and must never be copied into this file.
ADMIN_INTELLIGENCE_BACKEND=sqlite
ADMIN_INTELLIGENCE_POSTGRES_DSN=

# Read-only database credentials only.
POTAPOFF_DB_PASSWORD=
SUBSCRIPTION_DB_PASSWORD=
MEMECOIN_DB_PASSWORD=

# Host Nginx is the only trusted reverse proxy in this deployment.
# nginx-admin.conf overwrites X-Forwarded-For with a controlled two-hop chain.
ADMIN_TRUST_PROXY=true
ADMIN_TRUSTED_PROXY_HOPS=1
ADMIN_ALLOWED_ORIGINS=https://admin.potapoff.fun
