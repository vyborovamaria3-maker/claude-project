ADMIN_APP_NAME=POTAPoff Administrator
ADMIN_ENVIRONMENT=production
ADMIN_USERNAME=admin
# Generate: docker compose run --rm admin python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_SECURE_COOKIE=true
ADMIN_SOURCES_FILE=/config/sources.json
ADMIN_LOGS_FILE=/config/logs.json
ADMIN_AUDIT_DB=/var/lib/potapoff-admin/audit.db
# Optional: 10.0.0.0/8,203.0.113.15/32
ADMIN_ALLOWED_NETWORKS=
ADMIN_MAX_PAGE_SIZE=250
ADMIN_MAX_EXPORT_ROWS=10000
ADMIN_SHOW_SENSITIVE=false
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Read-only database users are strongly recommended.
POTAPOFF_DB_PASSWORD=replace-me
SUBSCRIPTION_DB_PASSWORD=replace-me
MEMECOIN_DB_PASSWORD=replace-me

# Trust reverse proxy headers only when Nginx/Traefik is under your control.
ADMIN_TRUST_PROXY=false
ADMIN_TRUSTED_PROXY_HOPS=1
ADMIN_ALLOWED_ORIGINS=https://admin.example.com
