# Local secrets and runtime configuration
.codex/
.codex/config.toml
**/.env
**/.env.local
**/.env.*.local
**/.env.server
**/.env.production
**/.env.development
**/.env.intelligence
**/secrets/
**/*.pem
**/*.key

# Keep checked-in templates
!**/.env.example
!**/.env.*.example

# Browser/session/auth state
**/storage-state.json
**/*.storage-state.json
**/data/x-auth/
**/*.session
**/*.session-journal

# Dependencies and build outputs
**/node_modules/
**/.next/
**/dist/
**/build/
**/out/
**/.turbo/
**/.cache/
**/coverage/
**/.coverage
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.tsbuildinfo
**/*.egg-info/

# Logs and local databases
**/*.log
**/*.err.log
**/*.out.log
**/*.db
**/*.db-*
**/*.db-wal
**/*.sqlite
**/*.sqlite3
**/*.snapshot.json
**/__pycache__/
**/*.pyc

# Local security-scan evidence may contain URLs, headers, payloads or session context.
security/audit/reports/

# Generated deployment snapshots and temporary exports
.deploy/
**/.deploy/
artifacts/
exports/
backups/
tmp/
temp/

# Repository hygiene
/tmp-*
**/tmp-*
*.vsix
*.zip

# Nested repositories and temporary clones
repo/
work/
cockpit-tools/
_tmp-vnc/
.playwright-mcp/
turbopack-*/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
