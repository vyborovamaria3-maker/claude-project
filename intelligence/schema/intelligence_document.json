{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POTAPoff Intelligence Document",
  "type": "object",
  "required": ["id", "source", "content", "collected_at"],
  "properties": {
    "id": {"type": "string"},
    "source": {"type": "string"},
    "source_id": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"]},
    "author": {"type": ["object", "null"]},
    "content": {"type": "string"},
    "published_at": {"type": ["string", "null"]},
    "collected_at": {"type": "string"},
    "entities": {"type": "array"},
    "metrics": {"type": "object"},
    "raw_hash": {"type": "string"},
    "provider": {"type": "string"}
  }
}
