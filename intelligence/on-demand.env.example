# Request-only configuration (example values only; set secrets in runtime store)
INTELLIGENCE_API_ENABLED=true
INTELLIGENCE_AI_ON_DEMAND_ENABLED=true
POTAPOFF_TOKEN_INTELLIGENCE_ENABLED=true
INTELLIGENCE_API_PORT=3182
# INTELLIGENCE_API_TOKEN=<server-only random token, 32+ characters>
# INTELLIGENCE_DATABASE_URL=<read API role, separate Intelligence PostgreSQL>
# INTELLIGENCE_AI_DATABASE_URL=<writer role, same Intelligence database>
# X_SOURCE_DATABASE_URL=<existing X collector>
# TG_SOURCE_DATABASE_URL=<existing Telegram collector>
# SOLANA_TRADE_DB_PATH=<existing trade.db>
INTELLIGENCE_AI_ENABLED=false
INTELLIGENCE_ETL_ENABLED=false
INTELLIGENCE_SUPERVISOR_ENABLED=false
AI_GATEWAY_ENABLED=true
# AI_DEFAULT_PROVIDER=<provider ID>
# AI_PROVIDERS_JSON=[{"id":"provider","baseUrl":"https://provider.example/v1","apiKeyEnv":"PROVIDER_API_KEY","chatModel":"model","maxConcurrent":1,"requestsPerMinute":5,"maxOutputTokens":512}]
