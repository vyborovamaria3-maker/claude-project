{
  "name": "@claude-project/intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@claude-project/contracts": "file:../packages/contracts",
    "@claude-project/event-outbox": "file:../packages/event-outbox",
    "pg": "^8.16.3",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/better-sqlite3": "^7.6.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run test",
    "etl:status": "node scripts/run.mjs --status",
    "etl:once": "node scripts/run.mjs --once",
    "etl:supervise": "node scripts/supervise.mjs --sources x,tg,blockchain",
    "etl:backfill": "node scripts/backfill.mjs",
    "etl:quality": "node scripts/quality.mjs",
    "api:local": "node api/start.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
