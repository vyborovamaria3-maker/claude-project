# Get API_ID and API_HASH from https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# Absolute or relative path; never commit the session file
TG_SESSION_FILE=.tg-session
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tg_collector
TG_POLL_SECONDS=300
TG_BATCH_SIZE=100
TG_MAX_PAGES_PER_JOB=20
TG_INITIAL_MESSAGE_LIMIT=500

# Optional: dedicated key for encrypting proxy credentials in PostgreSQL.
# If omitted, TG_API_HASH is used as the local encryption key source.
TG_PROXY_ENCRYPTION_KEY=

# Optional: dedicated public fixture channel for smoke:mtproto.
# Keep it stable and seed it with at least TG_SMOKE_EXPECTED_MESSAGES text posts.
TG_SMOKE_TEST_CHANNEL=
TG_SMOKE_EXPECTED_MESSAGES=100

# Backup defaults (never commit actual credentials or dump files).
TG_BACKUP_DIR=./backups
TG_BACKUP_RETENTION_DAYS=7
# Optional rclone remote, configured outside Git:
# TG_BACKUP_RCLONE_REMOTE=

# Alchemy Solana HTTPS RPC URL for validating mint accounts. Never commit a real API key.
ALCHEMY_SOLANA_RPC_URL=

# Optional read-only PostgreSQL source containing existing twitter_tweets.
# Keep the actual connection string outside Git. No Twitter API credentials needed.
TG_DISCOVERY_TWITTER_DATABASE_URL=
