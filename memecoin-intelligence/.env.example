NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Local/Docker infrastructure. Replace example passwords before any shared deployment.
# Bootstrap identity: used only by PostgreSQL initialization and the one-shot role provisioner.
POSTGRES_USER=memecoin
POSTGRES_PASSWORD=change_me_postgres
# Separate production logins. Runtime must never use POSTGRES_USER.
POSTGRES_APP_USER=memecoin_app
POSTGRES_APP_PASSWORD=replace-with-64-char-random-hex
POSTGRES_MIGRATOR_USER=memecoin_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-with-another-64-char-random-hex
# Dedicated SELECT-only login for Admin Control Center's source connection.
POSTGRES_READONLY_PASSWORD=replace-with-64-char-random-hex
POSTGRES_DB=memecoin
REDIS_PASSWORD=change_me_redis
# Local direct-development DSN only; production Compose overrides API and migrator URLs with their dedicated roles.
DATABASE_URL=postgresql://memecoin:change_me_postgres@localhost:5432/memecoin
REDIS_URL=redis://:change_me_redis@localhost:6379
DATA_PROVIDER=fixture
FIXTURE_PATH=./fixtures/x-posts.json
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=
SEARCH_PAGES=2
SEARCH_CACHE_SECONDS=300
MAX_SEARCH_RESULTS=500

# Performance tuning
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000
ANALYSIS_MAX_CANDIDATE_PAIRS=300000
ANALYSIS_MAX_FEATURE_FANOUT=180
ANALYSIS_TIME_BUCKET_MINUTES=5
INGEST_BATCH_SIZE=5000
WORKER_CONCURRENCY=4

# Telegram-only local AI. Disabled by default and never used by X analysis.
TELEGRAM_AI_ENABLED=false
TELEGRAM_AI_MODE=mock
TELEGRAM_AI_BASE_URL=http://localhost:8000/v1
TELEGRAM_AI_DOCKER_BASE_URL=http://qwen:8000/v1
TELEGRAM_AI_API_KEY=
TELEGRAM_AI_MODEL=Qwen/Qwen2.5-7B-Instruct
TELEGRAM_AI_TIMEOUT_MS=180000
TELEGRAM_AI_MAX_MESSAGES=60
TELEGRAM_AI_MAX_CHARS=24000
TELEGRAM_AI_MAX_TOKENS=1200
TELEGRAM_AI_TEMPERATURE=0.1
TELEGRAM_AI_CACHE_SECONDS=604800
TELEGRAM_AI_WORKER_CONCURRENCY=1

# Qwen inference container (Docker profile: ai)
QWEN_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
QWEN_REVISION=
QWEN_LOAD_MODE=4bit
QWEN_MAX_INPUT_TOKENS=8192
QWEN_MAX_OUTPUT_TOKENS=1536
QWEN_LAZY_LOAD=true
HF_TOKEN=

# Opt-in strict API response security headers. Disabled by default for compatibility.
SECURITY_HEADERS_STRICT=false

# Optional API access control. Existing behavior is preserved while RBAC is disabled.
SECURITY_RBAC_ENABLED=false
INTERNAL_API_KEY=
INTERNAL_ADMIN_API_KEY=
INTERNAL_USER_API_KEY=
