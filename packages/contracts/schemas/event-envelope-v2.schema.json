{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.potapoff.local/event-envelope-v2.schema.json",
  "title": "POTAPoff Event Envelope V2",
  "type": "object",
  "required": [
    "envelopeVersion",
    "eventId",
    "sourceSystem",
    "eventKind",
    "eventKey",
    "schemaVersion",
    "producer",
    "clocks",
    "entityRefs",
    "evidenceRefs",
    "payload",
    "payloadSha256"
  ],
  "additionalProperties": false,
  "properties": {
    "envelopeVersion": {
      "const": "event-envelope-v2"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_v2_[a-f0-9]{64}$"
    },
    "sourceSystem": {
      "type": "string",
      "enum": [
        "x",
        "tg",
        "blockchain"
      ]
    },
    "eventKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "eventKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "clocks": {
      "type": "object",
      "required": [
        "occurredAt",
        "observedAt",
        "emittedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "occurredAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "observedAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40
        },
        "emittedAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40
        }
      }
    },
    "entityRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "canonicalId"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "token",
              "wallet",
              "author",
              "source"
            ]
          },
          "canonicalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "sourceKind",
          "sourceId",
          "observedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "sourceKind": {
            "type": "string",
            "enum": [
              "x_tweet",
              "tg_message",
              "chain_tx"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "observedAt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40
          },
          "occurredAt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "parserVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "rawPointer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "coverageRef": {
      "type": "object",
      "required": [
        "sourceSystem",
        "scope",
        "windowStart",
        "windowEnd",
        "status",
        "coverageId"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceSystem": {
          "type": "string",
          "enum": [
            "x",
            "tg",
            "blockchain"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "windowStart": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40
        },
        "windowEnd": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "coverageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "payload": {
      "type": "object"
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
