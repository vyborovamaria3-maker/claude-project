# Copy to security/strix/.env and fill in your provider key.
# security/strix/.env is ignored by git.

STRIX_LLM=openai/gpt-5.4
LLM_API_KEY=

# Defaults used by scripts/strix-scan.sh when CLI flags are omitted.
STRIX_COMPONENT=repo
STRIX_PROFILE=baseline
STRIX_SCAN_MODE=standard
STRIX_MAX_BUDGET=10
STRIX_SCOPE_MODE=full
STRIX_DIFF_BASE=main
